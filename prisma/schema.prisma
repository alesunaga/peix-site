// PEIx — Site Institucional
// Schema Prisma — v1.1
//
// Referência: Requisitos_Site_PEIx_v1.1 e Arquitetura_Tecnica_Site_PEIx_v1.1
// Este schema cobre apenas o site institucional (leads, newsletter, blog,
// diagnóstico e admin). NÃO compartilha banco com o sistema PEIx (produto).
//
// Local sugerido no projeto Next.js: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Leads (RF-LEAD-01 a 07, RN-SITE-01 / RN-LEAD-01)
// ---------------------------------------------------------------------------

model Lead {
  id                  String     @id @default(cuid())

  // Campos do formulário de Contato (RF-LEAD-01)
  nome                String
  email               String     @unique
  telefone            String?
  instituicao         String?
  cidade              String?
  uf                  String?
  cargo               Cargo?
  segmentos           Segmento[]
  querDemo            Boolean    @default(false)

  // Rastreio e origem
  origem              LeadOrigem @default(FORMULARIO)
  utmSource           String?

  // LGPD (RF-LEAD-03, RNF-05)
  consentimentoLgpdEm DateTime?

  // Termos de Uso (RF-SITE-06, RF-DIAG-07, RN-DIAG-02)
  aceiteTermosUsoEm   DateTime?

  criadoEm            DateTime   @default(now())
  atualizadoEm        DateTime   @updatedAt

  diagnosticos        Diagnostico[]

  @@map("leads")
}

enum Cargo {
  DIRETOR_PEDAGOGICO
  MANTENEDOR_DONO
  COORDENADOR_INCLUSAO
  PROFESSOR_AEE
  OUTRO

  @@map("cargo")
}

enum Segmento {
  EDUCACAO_INFANTIL
  FUNDAMENTAL_1
  FUNDAMENTAL_2
  ENSINO_MEDIO

  @@map("segmento")
}

enum LeadOrigem {
  FORMULARIO
  DIAGNOSTICO

  @@map("lead_origem")
}

// ---------------------------------------------------------------------------
// Newsletter (RF-BLOG-03 a 06, RN-SITE-02 / RN-SITE-03)
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id               String             @id @default(cuid())
  nome             String?
  email            String             @unique

  // Double opt-in (RF-BLOG-04)
  status           NewsletterStatus   @default(PENDENTE)
  tokenConfirmacao String             @unique
  confirmadoEm     DateTime?
  descadastradoEm  DateTime?

  criadoEm         DateTime           @default(now())

  @@map("newsletter_subscribers")
}

enum NewsletterStatus {
  PENDENTE
  CONFIRMADO
  DESCADASTRADO

  @@map("newsletter_status")
}

// ---------------------------------------------------------------------------
// Blog (RF-BLOG-01, 02, 07, 08, RN-SITE-04)
// ---------------------------------------------------------------------------

model Post {
  id            String           @id @default(cuid())
  titulo        String
  slug          String           @unique
  resumo        String
  conteudo      String           @db.Text
  categoria     PostCategoria
  imagemCapaUrl String?

  // RF-ADMIN-05/v1.3: autor deixou de ser texto livre e virou FK — agora há
  // múltiplos admins reais. Sem dados existentes para migrar (painel admin
  // ainda não tinha sido implementado).
  autorId       String
  autor         AdminUser        @relation(fields: [autorId], references: [id])

  // RN-SITE-04: só status = PUBLICADO (e publicadoEm <= agora) fica visível
  // publicamente. AGENDADO (RF-ADMIN-12) segue a mesma regra de visibilidade
  // de RASCUNHO (RN-ADMIN-02) — só acessível via link de preview assinado.
  status        PostStatus       @default(RASCUNHO)
  publicadoEm   DateTime?

  criadoEm      DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt

  envios        NewsletterSend[]
  previewTokens PostPreviewToken[]

  @@map("posts")
}

enum PostStatus {
  RASCUNHO
  AGENDADO
  PUBLICADO

  @@map("post_status")
}

// RF-ADMIN-11 — link de preview assinado para posts não publicados
// (rascunho/agendado), acessível sem exigir login de quem recebe o link.
model PostPreviewToken {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id])
  token    String   @unique
  expiraEm DateTime
  criadoEm DateTime @default(now())

  @@map("post_preview_tokens")
}

enum PostCategoria {
  INCLUSAO
  LEGISLACAO
  IDEIAS_BOAS_PRATICAS
  EXPERIENCIAS
  ENTREVISTAS
  EVENTOS

  @@map("post_categoria")
}

// Auditoria de cada disparo em lote de newsletter (RF-BLOG-05)
model NewsletterSend {
  id                 String   @id @default(cuid())
  postId             String
  post               Post     @relation(fields: [postId], references: [id])

  disparadoEm        DateTime @default(now())
  totalDestinatarios Int
  totalSucesso       Int
  totalFalha         Int

  @@map("envios_newsletter")
}

// ---------------------------------------------------------------------------
// Diagnóstico de Conformidade (RF-DIAG-01 a 06, RN-DIAG-01)
// ---------------------------------------------------------------------------

model Diagnostico {
  id         String               @id @default(cuid())
  leadId     String
  lead       Lead                 @relation(fields: [leadId], references: [id])

  // Respostas brutas do wizard, para auditoria/reavaliação futura de pesos
  respostas  Json

  // Calculado no servidor a partir das respostas — nunca confiar em valor vindo do cliente
  pontuacao  Int
  categoria  DiagnosticoCategoria

  criadoEm   DateTime             @default(now())

  @@map("diagnosticos")
}

enum DiagnosticoCategoria {
  INICIANTE
  EM_TRANSICAO
  AVANCADA

  @@map("diagnostico_categoria")
}

// ---------------------------------------------------------------------------
// Admin (RF-ADMIN-01 a 12) — Arquitetura_Tecnica_Site_PEIx v1.3, §3
// ---------------------------------------------------------------------------

model AdminUser {
  id        String      @id @default(cuid())
  email     String      @unique

  // Nullable até o convite ser aceito (RF-ADMIN-06) — a senha nunca é
  // definida nem transmitida pelo administrador que convida.
  senhaHash String?

  status    AdminStatus @default(CONVIDADO)

  // Convite (RF-ADMIN-06/07)
  tokenConvite     String?     @unique
  conviteExpiraEm  DateTime?
  convidadoPorId   String?
  convidadoPor     AdminUser?  @relation("ConvitesAdmin", fields: [convidadoPorId], references: [id])
  convidados       AdminUser[] @relation("ConvitesAdmin")

  // Recuperação de senha (RF-ADMIN-08) — token de uso único
  tokenResetSenha  String?     @unique
  resetExpiraEm    DateTime?

  // Revogação de sessão ao trocar de senha: toda sessão (cookie assinado
  // stateless — ver src/lib/admin-session.ts) carrega o instante em que foi
  // emitida ("iat"); getAdminAtual() rejeita sessões emitidas antes de
  // senhaAlteradaEm. Sem isso, resetar a senha por segurança (ex.: conta
  // comprometida) não derrubava sessões já abertas em outro lugar.
  senhaAlteradaEm  DateTime?

  // Lockout por tentativas malsucedidas (RN-ADMIN-04) — padrão simplificado
  // (mesmo usado no sistema PEIx produto): tentativasLogin é reiniciado a
  // cada login bem-sucedido ou quando bloqueadoAte expira.
  tentativasLogin  Int         @default(0)
  bloqueadoAte     DateTime?

  criadoEm  DateTime @default(now())

  posts     Post[]

  @@map("admin_users")
}

enum AdminStatus {
  CONVIDADO
  ATIVO
  DESATIVADO

  @@map("admin_status")
}

// ---------------------------------------------------------------------------
// Analytics próprio — Analytics_Proprio_Site_PEIx_v1.0
//
// Sem cookies, sem IP/User-Agent brutos armazenados. visitanteHash é um
// SHA-256(IP + User-Agent + data do dia + salt), calculado em
// src/lib/analytics.ts — muda todo dia, então não permite reidentificar o
// mesmo visitante ao longo do tempo, só contar "visitantes únicos por dia".
// Mantém a Politica_Privacidade_PEIx §8 inalterada (nenhum cookie de
// rastreamento, nenhum dado compartilhado com rede de anúncios).
// ---------------------------------------------------------------------------

model AnalyticsPageview {
  id             String            @id @default(cuid())
  path           String
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  visitanteHash  String
  dispositivo    AnalyticsDispositivo @default(DESCONHECIDO)

  criadoEm       DateTime          @default(now())

  @@index([criadoEm])
  @@index([path])
  @@map("analytics_pageviews")
}

enum AnalyticsDispositivo {
  DESKTOP
  MOBILE
  TABLET
  DESCONHECIDO

  @@map("analytics_dispositivo")
}

model AnalyticsEvento {
  id            String              @id @default(cuid())
  tipo          AnalyticsEventoTipo
  path          String?
  visitanteHash String?
  metadata      Json?

  criadoEm      DateTime            @default(now())

  @@index([criadoEm])
  @@index([tipo])
  @@map("analytics_eventos")
}

enum AnalyticsEventoTipo {
  DIAGNOSTICO_CONCLUIDO
  FORMULARIO_ENVIADO
  NEWSLETTER_INSCRITA
  POST_LIDO

  @@map("analytics_evento_tipo")
}
