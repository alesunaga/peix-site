# Banco de dados (Railway — plugin PostgreSQL do PROJETO DO SITE, separado do PEIx produto)
DATABASE_URL="postgresql://user:password@host:5432/peix_site"

# URL canônica do site — usada em links absolutos de e-mail, SEO e sitemap.xml
# (src/lib/site.ts). Fixada em www porque a raiz peix.ia.br ainda não tem
# CNAME/A configurado no DNS (ver Arquitetura_Tecnica v1.5). Trocar aqui
# quando isso mudar, ou para apontar pra um domínio de preview/staging.
NEXT_PUBLIC_SITE_URL="https://www.peix.ia.br"

# Resend
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="PEIx <contato@peix.ia.br>"

# Representante comercial (RF-LEAD-07)
REPRESENTANTE_EMAIL="contato@peix.ia.br"

# Material informativo (RF-LEAD-06) — se vazio, cai no fallback
# ${NEXT_PUBLIC_SITE_URL}/materiais/decreto-12773.pdf
MATERIAL_INFORMATIVO_URL="https://www.peix.ia.br/materiais/decreto-12773.pdf"

# Cloudflare R2 (imagens de capa dos posts do blog — RF-ADMIN-10)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="peix-site-assets"
R2_ENDPOINT=""
# URL pública para servir os objetos do bucket (domínio customizado ou o
# endereço público *.r2.dev do bucket) — usada para montar imagemCapaUrl.
R2_PUBLIC_URL=""

# Sessão do painel admin (RF-ADMIN-01)
ADMIN_SESSION_SECRET="gerar-com: openssl rand -base64 32"

# Job de agendamento de posts (RF-ADMIN-12) — segredo compartilhado enviado
# pelo scheduler externo (Railway Cron ou equivalente) no header
# `Authorization: Bearer <CRON_SECRET>` ao chamar POST /api/cron/publicar-agendados.
CRON_SECRET="gerar-com: openssl rand -base64 32"

# API de leitura de leads para a pipeline de clientes externa — segredo
# compartilhado enviado no header `Authorization: Bearer <LEADS_API_TOKEN>`
# ao chamar GET /api/integrations/leads. Gerar um valor distinto do
# CRON_SECRET (finalidades diferentes; revogar um não deve afetar o outro).
LEADS_API_TOKEN="gerar-com: openssl rand -base64 32"

# Analytics próprio (Analytics_Proprio_Site_PEIx_v1.0) — salt usado para
# calcular o hash de visitante (IP + User-Agent + data + salt). Nunca
# persistimos IP/UA brutos, só este hash — trocar o salt em produção
# invalida a "identidade" diária de todo mundo (efeito colateral aceitável,
# não é PII). Gerar um valor próprio, não usar o default de dev.
ANALYTICS_SALT="gerar-com: openssl rand -base64 32"
